  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Consider sales in stock"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A14B2DFD-3BF2-4600-9C3E-EEC7354D522A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Consider sales in stock"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CF46A5DD-862E-4E6F-92F8-4E4D0FAE2DF1}"
          SQLTask:SqlStatementSource="INSERT INTO hStock (product_sk, date, date_t, variation)&#xA;SELECT &#xA;    bd.product_sk, &#xA;    b.date,             -- La fecha limpia de la cabecera&#xA;    b.date_t,           -- La hora exacta de la transacción&#xA;    SUM(bd.quantity * -1) AS variation -- Lo volvemos negativo&#xA;FROM hBillingDetail bd&#xA;INNER JOIN hBilling b ON bd.billing_sk = b.billing_sk&#xA;GROUP BY &#xA;    bd.product_sk, &#xA;    b.date,&#xA;    b.date_t;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Data into Billing"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8749A684-3A6E-4C24-8DB3-9EFEF51E0D65}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Data into Billing"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CF46A5DD-862E-4E6F-92F8-4E4D0FAE2DF1}"
          SQLTask:SqlStatementSource="-- Calcular Subtotal y Volumen Total por Factura&#xA;UPDATE b&#xA;SET &#xA;    b.subtotal = agg.total_subtotal,&#xA;    b.volume_sold_liters = agg.total_volume&#xA;FROM hBilling b&#xA;INNER JOIN (&#xA;    -- Agrupamos los detalles de cada factura&#xA;    SELECT &#xA;        bd.billing_sk,&#xA;        SUM(bd.quantity * bd.unit_price) AS total_subtotal,&#xA;        SUM(bd.quantity * p.volume_liters) AS total_volume&#xA;    FROM hBillingDetail bd&#xA;    INNER JOIN dProducts p ON bd.product_sk = p.product_sk&#xA;    GROUP BY bd.billing_sk&#xA;) agg ON b.billing_sk = agg.billing_sk;&#xA;&#xA;-- Aplicar Descuentos&#xA;UPDATE b&#xA;SET &#xA;    b.discount_percentage = ISNULL(desc_vigente.percentage, 0),&#xA;    b.discount_amount = b.subtotal * (ISNULL(desc_vigente.percentage, 0) / 100.0),&#xA;    b.final_billing = b.subtotal - (b.subtotal * (ISNULL(desc_vigente.percentage, 0) / 100.0))&#xA;FROM hBilling b&#xA;OUTER APPLY (&#xA;    -- Buscamos TODOS los descuentos válidos para la fecha y el monto,&#xA;    -- y nos quedamos únicamente con el TOP 1 (el de mayor porcentaje)&#xA;    SELECT TOP 1 d.percentage&#xA;    FROM Discounts d&#xA;    WHERE b.date_t &gt;= d.date_from &#xA;      AND b.date_t &lt;= d.date_until&#xA;      AND b.subtotal &gt;= d.total_billing&#xA;    ORDER BY d.percentage DESC &#xA;) AS desc_vigente;&#xA;&#xA;-- Calcular Edades y Antigüedad (A la fecha de la factura)&#xA;UPDATE b&#xA;SET&#xA;    -- Cálculo de edad exacta (resta años y ajusta si aún no cumplió en ese año)&#xA;    b.customer_age = DATEDIFF(YEAR, c.birth_date, b.date) - &#xA;                     CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, c.birth_date, b.date), c.birth_date) &gt; b.date THEN 1 ELSE 0 END,&#xA;                     &#xA;    b.employee_age = DATEDIFF(YEAR, e.birth_date, b.date) - &#xA;                     CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, e.birth_date, b.date), e.birth_date) &gt; b.date THEN 1 ELSE 0 END,&#xA;                     &#xA;    b.employee_seniority = DATEDIFF(YEAR, e.employment_date, b.date) - &#xA;                           CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, e.employment_date, b.date), e.employment_date) &gt; b.date THEN 1 ELSE 0 END,&#xA;&#xA;   b.employee_gender = e.gender&#xA;FROM hBilling b&#xA;LEFT JOIN dCustomer c ON b.customer_sk = c.customer_sk&#xA;LEFT JOIN dEmployee e ON b.employee_sk = e.employee_sk;&#xA;&#xA;-- Asignar Grupo Etario del Cliente&#xA;UPDATE b&#xA;SET b.customer_age_group_id = ag.age_group_id&#xA;FROM hBilling b&#xA;INNER JOIN dAgeGroup ag &#xA;    ON b.customer_age &gt;= ag.min_age &#xA;   AND b.customer_age &lt;= ag.max_age;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
