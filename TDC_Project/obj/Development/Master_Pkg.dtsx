                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[Products]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    product_id,
    detail,
    package,
    CASE WHEN LOWER(detail) LIKE '%cola%' THEN 'cola' 
         WHEN LOWER(detail) LIKE '%beer%' THEN 'beer' 
         WHEN LOWER(detail) LIKE '%energy drink%' THEN 'energy drink' 
         WHEN LOWER(detail) LIKE '%soda%' THEN 'soda' 
         WHEN LOWER(detail) LIKE '%juice%' THEN 'juice' 
         ELSE 'Other' END AS category,
    CASE WHEN LOWER(package) LIKE '%can%' THEN 1 ELSE 0 END AS is_can,
    CASE WHEN LOWER(detail) LIKE '%diet%' THEN 1 ELSE 0 END AS is_diet,
    CASE WHEN LOWER(package) LIKE '%1 liter%' THEN 1.0 
         WHEN LOWER(package) LIKE '%2 liter%' THEN 2.0 
         WHEN LOWER(package) LIKE '%670 cm3%' THEN 0.67
         WHEN LOWER(package) LIKE '%330 cm3%' THEN 0.33
         WHEN LOWER(package) LIKE '%500 cm3%' THEN 0.5 
         ELSE 0.0 END AS volume_liters
FROM Products</property>
