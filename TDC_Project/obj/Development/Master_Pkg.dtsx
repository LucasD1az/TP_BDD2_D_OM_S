                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH HistoryDetails AS (
    SELECT 
        billing_id, 
        product_id, 
        quantity
    FROM HistorySales
),
SalesDetails AS (
    -- IMPORTANTE: Ajustá el nombre de tu tabla de detalles de Staging acá
    SELECT 
        billing_id, 
        product_id, 
        quantity
    FROM Billing_Detail 
),
CombinedDetails AS (
    SELECT * FROM HistoryDetails
    UNION ALL
    SELECT * FROM SalesDetails
)
-- Agrupamos para asegurar una única línea por producto dentro de la misma factura
SELECT 
    billing_id,
    product_id,
    SUM(quantity) AS quantity
FROM CombinedDetails
GROUP BY 
    billing_id, 
    product_id;</property>
                <property
