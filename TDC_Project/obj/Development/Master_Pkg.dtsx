    <DTS:Executable
      DTS:refId="Package\Load Prices into BillingDetail"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E2C9EE8A-4EE3-47F6-A684-0E20396E31DB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Prices into BillingDetail"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CF46A5DD-862E-4E6F-92F8-4E4D0FAE2DF1}"
          SQLTask:SqlStatementSource="UPDATE bd&#xA;SET &#xA;    bd.unit_price = precio_vigente.price&#xA;FROM hBillingDetail bd&#xA;INNER JOIN hBilling b ON bd.billing_sk = b.billing_sk&#xA;INNER JOIN dProducts p ON bd.product_sk = p.product_sk&#xA;OUTER APPLY (&#xA;    -- Para cada producto vendido, buscamos su precio más reciente &#xA;    -- que sea menor o igual a la fecha exacta de la factura (date_t)&#xA;    SELECT TOP 1 pr.price&#xA;    FROM Prices pr&#xA;    WHERE pr.product_id = p.product_id&#xA;      AND pr.date &lt;= b.date_t&#xA;    ORDER BY pr.date DESC&#xA;) AS precio_vigente&#xA;WHERE precio_vigente.price IS NOT NULL; &#xA;-- Si el Outer Apply no encuentra precio devuelve NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
